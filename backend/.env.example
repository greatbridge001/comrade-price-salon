# --- Database (Neon) ---
# Neon dashboard > Connect > copy the connection string. It must end with ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require

# --- Auth ---
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# --- CORS ---
# Comma-separated list of frontend addresses allowed to call this API.
# Add the address you open the site from (Live Server uses http://127.0.0.1:5500). A wildcard such as https://*.vercel.app is allowed.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,https://your-site.vercel.app

# --- Server ---
PORT=4000
NODE_ENV=development
# Creates tables automatically on startup (safe to leave on; the schema is idempotent).
AUTO_MIGRATE=true

# --- First admin account (used only by `npm run db:create-admin` / `npm run db:setup`) ---
# Use a strong password (10+ characters), run the command once, then delete ADMIN_PASSWORD from this file.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=
